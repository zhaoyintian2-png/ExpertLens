# ============================================================
# ExpertLens 环境变量模板
# 使用方法：复制本文件并重命名为 .env，填入你自己的密钥
#   macOS / Linux : cp .env.example .env
#   Windows      : copy .env.example .env
# ============================================================

# Gemini API 密钥（必填）
# 获取地址：https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 使用的模型（可选，默认 gemini-3.6-flash）
VITE_GEMINI_MODEL=gemini-3.6-flash

# 注意事项：
# 1. Vite 只会注入以 VITE_ 开头的环境变量，请保留前缀
# 2. 修改 .env 后需要重启开发服务器才能生效
# 3. .env 已被 .gitignore 排除，切勿提交到版本库
